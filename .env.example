# Olive AI - example environment configuration
#
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets or API keys.
# Phase 1 requires no credentials at all -- the values below are the
# full set of settings Olive currently understands.

APP_NAME=Olive AI
ENVIRONMENT=development
LOG_LEVEL=INFO
OLIVE_DATA_MODE=development

# Market-data provider credentials (e.g. Databento) are not used by
# Olive AI yet. They will be introduced in Phase 3 (Historical Market
# Data) with their own documented placeholders here.
