# Olive AI - example environment configuration
#
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets or API keys.
# Phase 1 requires no credentials at all -- the values below are the
# full set of settings Olive currently understands.

APP_NAME=Olive AI
ENVIRONMENT=development
LOG_LEVEL=INFO
OLIVE_DATA_MODE=development

# -- Phase 3: historical market data --------------------------------------
# Safe defaults below never cause a network call or a paid request by
# themselves. See docs/historical_data.md for the full configuration
# contract and the safety gates HistoricalDataService enforces.

# Which historical provider Olive uses. "unconfigured" (the default) is
# always safe. The only other supported value is "databento".
OLIVE_HISTORICAL_PROVIDER=unconfigured

# Databento API key. Leave blank. NEVER commit a real key -- this file is
# a template; your real key belongs only in a local, git-ignored .env.
# Olive never logs, echoes, or includes this value in any error message,
# manifest, or health/status output.
DATABENTO_API_KEY=

# Local root directory for Olive's downloaded historical Parquet data.
# Defaults to <project root>/data/historical if left unset. A relative
# path here is always resolved against Olive's own project root, never
# the current working directory main.py happens to be launched from --
# the same configuration always resolves to the same absolute path
# regardless of invocation directory (Phase 3.1 fix; see
# docs/historical_data.md §10). Set an absolute path here to pin an
# exact location explicitly.
OLIVE_HISTORICAL_DATA_DIR=

# Master network kill switch for historical data. Must be explicitly set
# to "true" for Olive to ever contact a historical data provider over the
# network. Defaults to "false".
OLIVE_HISTORICAL_NETWORK_ENABLED=false

# Maximum USD cost Olive will accept for a single historical fetch
# request (compared against the provider's own pre-fetch cost estimate).
# Defaults to 0, which rejects every paid request until raised
# deliberately.
OLIVE_HISTORICAL_MAX_REQUEST_COST_USD=0

# -- Phase 4: real-time market data ----------------------------------------
# Safe defaults below never cause a network call by themselves. See
# docs/realtime_data.md for the full configuration contract and the
# safety gates RealTimeDataService enforces. DATABENTO_API_KEY above is
# REUSED here -- Olive has exactly one Databento credential, shared by
# whichever of the historical and live subsystems is configured to use
# it; there is no separate live-only key setting.

# Which real-time provider Olive uses. "unconfigured" (the default) is
# always safe. The only other supported value is "databento".
OLIVE_LIVE_PROVIDER=unconfigured

# Master network kill switch for real-time data. Must be explicitly set
# to "true" for Olive to ever open a live streaming connection. This is
# a SEPARATE switch from OLIVE_HISTORICAL_NETWORK_ENABLED above --
# enabling one never enables the other. Defaults to "false".
OLIVE_LIVE_NETWORK_ENABLED=false

# How many seconds may elapse since the last received live event before
# the stream is considered stale (subject to market-session awareness --
# a legitimately closed/maintenance session is never reported as stale;
# see docs/realtime_data.md "Liveness and staleness"). Must be a
# strictly positive number of seconds. Defaults to 10.
OLIVE_LIVE_STALE_THRESHOLD_SECONDS=10

# Maximum number of consecutive reconnect attempts after a TRANSIENT
# connection failure before Olive gives up on a live stream. Permanent
# failures (authentication, permission) are never retried regardless of
# this setting. Defaults to 5.
OLIVE_LIVE_RECONNECT_MAX_ATTEMPTS=5

# Bounded-exponential-backoff reconnect delay bounds, in seconds. The
# delay before reconnect attempt N is base_delay * 2^(N-1), capped at
# max_delay. Both must be strictly positive, and max_delay must be >=
# base_delay. Defaults to 1 and 30 respectively.
OLIVE_LIVE_RECONNECT_BASE_DELAY_SECONDS=1
OLIVE_LIVE_RECONNECT_MAX_DELAY_SECONDS=30
