# Olive AI - example environment configuration
#
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets or API keys.
# Phase 1 requires no credentials at all -- the values below are the
# full set of settings Olive currently understands.

APP_NAME=Olive AI
ENVIRONMENT=development
LOG_LEVEL=INFO
OLIVE_DATA_MODE=development

# -- Phase 3: historical market data --------------------------------------
# Safe defaults below never cause a network call or a paid request by
# themselves. See docs/historical_data.md for the full configuration
# contract and the safety gates HistoricalDataService enforces.

# Which historical provider Olive uses. "unconfigured" (the default) is
# always safe. The only other supported value is "databento".
OLIVE_HISTORICAL_PROVIDER=unconfigured

# Databento API key. Leave blank. NEVER commit a real key -- this file is
# a template; your real key belongs only in a local, git-ignored .env.
# Olive never logs, echoes, or includes this value in any error message,
# manifest, or health/status output.
DATABENTO_API_KEY=

# Local root directory for Olive's downloaded historical Parquet data.
# Defaults to <project root>/data/historical if left unset. A relative
# path here is always resolved against Olive's own project root, never
# the current working directory main.py happens to be launched from --
# the same configuration always resolves to the same absolute path
# regardless of invocation directory (Phase 3.1 fix; see
# docs/historical_data.md §10). Set an absolute path here to pin an
# exact location explicitly.
OLIVE_HISTORICAL_DATA_DIR=

# Master network kill switch for historical data. Must be explicitly set
# to "true" for Olive to ever contact a historical data provider over the
# network. Defaults to "false".
OLIVE_HISTORICAL_NETWORK_ENABLED=false

# Maximum USD cost Olive will accept for a single historical fetch
# request (compared against the provider's own pre-fetch cost estimate).
# Defaults to 0, which rejects every paid request until raised
# deliberately.
OLIVE_HISTORICAL_MAX_REQUEST_COST_USD=0
